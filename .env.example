# Configuracao do Banco de Dados PostgreSQL (Docker Compose padrao)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/academic_flow

# Configuracao do LLM e Embeddings Locais (Ollama)
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
